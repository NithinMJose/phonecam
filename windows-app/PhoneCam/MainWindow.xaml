<Window x:Class="PhoneCam.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhoneCam"
        Width="1160" Height="740"
        MinWidth="820" MinHeight="540"
        Background="#111318"
        Foreground="#F3F4F6">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top status + controls bar -->
        <Border Grid.Row="0" Background="#1B1F27" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatus" Text="Starting..." FontSize="15" FontWeight="SemiBold" Foreground="#60A5FA" />
                    <TextBlock x:Name="TxtStats" Text="Waiting for stream..." FontFamily="Consolas" FontSize="12" Foreground="#D1D5DB" Margin="0,3,0,0" />
                    <TextBlock x:Name="TxtVirtualCam" Text="Virtual Cam: starting..." FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnVirtualCam" Content="VCam: Auto" Click="BtnVirtualCam_Click" Padding="10,5" Margin="0,0,8,0"
                            Background="#2A303C" Foreground="#F3F4F6" BorderThickness="0" />
                    <Button x:Name="BtnSwitchCam" Content="Cam: Back" Click="BtnSwitchCam_Click" Padding="10,5" Margin="0,0,8,0"
                            Background="#2A303C" Foreground="#F3F4F6" BorderThickness="0" />
                    <Button x:Name="BtnAdbReverse" Content="USB Re-bind" Click="BtnAdbReverse_Click" Padding="10,5" Margin="0,0,8,0"
                            Background="#2A303C" Foreground="#F3F4F6" BorderThickness="0" />
                    <Button x:Name="BtnRotate" Content="Rot: Auto" Click="BtnRotate_Click" Padding="10,5" Margin="0,0,8,0"
                            Background="#2A303C" Foreground="#F3F4F6" BorderThickness="0" />
                    <Button x:Name="BtnKeyframe" Content="Req Keyframe" Click="BtnKeyframe_Click" Padding="10,5" Margin="0,0,8,0"
                            Background="#2A303C" Foreground="#F3F4F6" BorderThickness="0" />
                    <ToggleButton x:Name="BtnSettings" Content="Settings" Checked="BtnSettings_Changed" Unchecked="BtnSettings_Changed"
                                  Padding="10,5" Margin="0,0,8,0" Background="#2A303C" Foreground="#F3F4F6" BorderThickness="0" />
                    <CheckBox x:Name="ChkDebugLog" Content="Debug Log" Checked="ChkDebugLog_Changed" Unchecked="ChkDebugLog_Changed"
                              Foreground="#D1D5DB" VerticalAlignment="Center" Margin="2,0,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main content: Video Preview + Collapsible Settings Panel -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#090B0E" CornerRadius="6" ClipToBounds="True">
                <Image x:Name="VideoPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality" />
            </Border>

            <!-- Collapsible Settings Panel -->
            <Border x:Name="SettingsPanel" Grid.Column="1" Width="280" Background="#1B1F27" CornerRadius="6"
                    Padding="14" Margin="10,0,0,0" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Camera Settings" FontSize="15" FontWeight="SemiBold" Foreground="#F3F4F6" Margin="0,0,0,12" />

                        <TextBlock Text="Resolution" FontSize="12" Foreground="#9CA3AF" />
                        <ComboBox x:Name="CmbResolution" Margin="0,4,0,10" Padding="6,4">
                            <ComboBoxItem Content="1920 x 1080 (1080p)" Tag="1920x1080" />
                            <ComboBoxItem Content="1280 x 720 (720p)" Tag="1280x720" />
                            <ComboBoxItem Content="960 x 540 (540p)" Tag="960x540" />
                            <ComboBoxItem Content="640 x 480 (480p)" Tag="640x480" />
                        </ComboBox>

                        <TextBlock Text="Frame Rate (FPS)" FontSize="12" Foreground="#9CA3AF" />
                        <ComboBox x:Name="CmbFps" Margin="0,4,0,10" Padding="6,4">
                            <ComboBoxItem Content="15 fps" Tag="15" />
                            <ComboBoxItem Content="24 fps" Tag="24" />
                            <ComboBoxItem Content="30 fps" Tag="30" />
                            <ComboBoxItem Content="60 fps" Tag="60" />
                        </ComboBox>

                        <Button x:Name="BtnApplyVideo" Content="Apply Resolution &amp; FPS" Click="BtnApplyVideo_Click"
                                Padding="8,6" Margin="0,0,0,14" Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" />

                        <DockPanel Margin="0,0,0,2">
                            <TextBlock Text="Bitrate" FontSize="12" Foreground="#9CA3AF" />
                            <TextBlock x:Name="TxtBitrateValue" Text="6 Mbps" FontSize="12" Foreground="#F3F4F6" HorizontalAlignment="Right" />
                        </DockPanel>
                        <Slider x:Name="SldBitrate" Minimum="2" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="6" ValueChanged="SldBitrate_ValueChanged" Margin="0,2,0,12" />

                        <DockPanel Margin="0,0,0,2">
                            <TextBlock Text="Zoom" FontSize="12" Foreground="#9CA3AF" />
                            <TextBlock x:Name="TxtZoomValue" Text="1.0x" FontSize="12" Foreground="#F3F4F6" HorizontalAlignment="Right" />
                        </DockPanel>
                        <Grid Margin="0,2,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SldZoom" Grid.Column="0" Minimum="1.0" Maximum="5.0" TickFrequency="0.1"
                                    SmallChange="0.1" LargeChange="0.5" Value="1.0" ValueChanged="SldZoom_ValueChanged"
                                    VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="1x" Click="BtnResetZoom_Click" Padding="8,2" Margin="6,0,0,0"
                                    Background="#2A303C" Foreground="#D1D5DB" BorderThickness="0" FontSize="11" />
                        </Grid>

                        <TextBlock Text="Orientation &amp; Mirror" FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,6" />
                        <CheckBox x:Name="ChkMirrorH" Content="Mirror Horizontal (Selfie)" Checked="TransformOption_Changed"
                                  Unchecked="TransformOption_Changed" Foreground="#D1D5DB" Margin="0,0,0,6" />
                        <CheckBox x:Name="ChkFlipV" Content="Flip Vertical" Checked="TransformOption_Changed"
                                  Unchecked="TransformOption_Changed" Foreground="#D1D5DB" Margin="0,0,0,12" />

                        <TextBlock Text="Window Behavior" FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,6" />
                        <CheckBox x:Name="ChkMinimizeToTray" Content="Minimize to tray on close"
                                  Checked="ChkMinimizeToTray_Changed" Unchecked="ChkMinimizeToTray_Changed"
                                  Foreground="#D1D5DB" Margin="0,0,0,12" />

                        <Button Content="Hide to Tray" Click="BtnHideToTray_Click" Padding="8,6"
                                Background="#2A303C" Foreground="#F3F4F6" BorderThickness="0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Collapsible Debug Log -->
        <Border x:Name="LogPanel" Grid.Row="2" Background="#1B1F27" CornerRadius="6" Padding="8" Margin="0,10,0,0" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="120" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock Text="Debug Log" FontSize="12" FontWeight="SemiBold" Foreground="#9CA3AF" VerticalAlignment="Center" />
                    <Button Content="Clear" Click="BtnClearLog_Click" HorizontalAlignment="Right" Padding="8,2"
                            Background="#2A303C" Foreground="#D1D5DB" BorderThickness="0" FontSize="11" />
                </DockPanel>
                <TextBox x:Name="TxtLog" Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" Background="#0E1116" Foreground="#A7F3D0"
                         FontFamily="Consolas" FontSize="11" BorderThickness="0" Padding="6" />
            </Grid>
        </Border>
    </Grid>
</Window>
