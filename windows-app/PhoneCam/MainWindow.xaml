<Window x:Class="PhoneCam.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PhoneCam"
        Icon="pack://application:,,,/Assets/PhoneCam.ico"
        Width="1160" Height="740"
        MinWidth="820" MinHeight="540"
        FontFamily="{StaticResource AppFont}"
        Background="#0C0F14"
        Foreground="#F3F4F6">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Clean Minimal Top Bar -->
        <Border Grid.Row="0" Background="#161B24" BorderBrush="#262F3F" BorderThickness="1" CornerRadius="12" Padding="16,11" Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/PhoneCam.ico" Width="24" Height="24" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                        <TextBlock Text="PhoneCam" FontSize="15.5" FontWeight="Bold" Foreground="#F3F4F6" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <Border Background="#11161F" BorderBrush="#262F3F" BorderThickness="1" CornerRadius="999" Padding="10,3" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtStatus" Text="Starting..." FontSize="12" FontWeight="Medium" Foreground="#93C5FD" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtVirtualCam" Text="Virtual Cam: starting..." FontSize="11.5" Foreground="#9CA3AF" Margin="34,3,0,0" />
                </StackPanel>

                <!-- Essential Consumer Controls Only -->
                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Name="BtnSwitchCam" Content="Cam: Back" Click="BtnSwitchCam_Click" Margin="0,0,8,0" />
                    <Button x:Name="BtnMic" Content="Mic: OFF" Click="BtnMic_Click" Margin="0,0,8,0" />
                    <Button x:Name="BtnRotate" Content="Rot: Auto" Click="BtnRotate_Click" Margin="0,0,8,0" />
                    <ToggleButton x:Name="BtnSettings" Content="Settings" Checked="BtnSettings_Changed" Unchecked="BtnSettings_Changed" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Main content: Clean Rounded Preview + Collapsible Settings Sidebar -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#07090D" BorderBrush="#1E2532" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                <Grid>
                    <!-- Shown cleanly when idle -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                        <Image Source="pack://application:,,,/Assets/PhoneCam.ico" Width="56" Height="56" Opacity="0.9" Margin="0,0,0,14" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="Waiting for Phone" FontSize="18" FontWeight="SemiBold" Foreground="#E5E7EB" HorizontalAlignment="Center" />
                        <TextBlock Text="Open PhoneCam on Android via USB or WiFi, then tap Start Camera."
                                   FontSize="13" Foreground="#6B7280" Margin="0,6,0,0" HorizontalAlignment="Center" />
                    </StackPanel>

                    <Border CornerRadius="12" ClipToBounds="True">
                        <Image x:Name="VideoPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality" />
                    </Border>
                </Grid>
            </Border>

            <!-- Collapsible Settings Sidebar -->
            <Border x:Name="SettingsPanel" Grid.Column="1" Width="312" Background="#161B24" BorderBrush="#262F3F" BorderThickness="1"
                    CornerRadius="12" Padding="14" Margin="12,0,0,0" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold" Foreground="#F3F4F6" Margin="2,0,0,12" />

                        <!-- Video Card -->
                        <Border Background="#11161F" BorderBrush="#222938" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="VIDEO" FontSize="10.5" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,10" />

                                <TextBlock Text="Resolution" FontSize="12" Foreground="#9CA3AF" />
                                <ComboBox x:Name="CmbResolution" Margin="0,4,0,10">
                                    <ComboBoxItem Content="1920 x 1080 (1080p)" Tag="1920x1080" />
                                    <ComboBoxItem Content="1280 x 720 (720p)" Tag="1280x720" />
                                    <ComboBoxItem Content="960 x 540 (540p)" Tag="960x540" />
                                    <ComboBoxItem Content="640 x 480 (480p)" Tag="640x480" />
                                </ComboBox>

                                <TextBlock Text="Frame Rate (FPS)" FontSize="12" Foreground="#9CA3AF" />
                                <ComboBox x:Name="CmbFps" Margin="0,4,0,10">
                                    <ComboBoxItem Content="15 fps" Tag="15" />
                                    <ComboBoxItem Content="24 fps" Tag="24" />
                                    <ComboBoxItem Content="30 fps" Tag="30" />
                                    <ComboBoxItem Content="60 fps" Tag="60" />
                                </ComboBox>

                                <Button x:Name="BtnApplyVideo" Content="Apply Resolution &amp; FPS" Click="BtnApplyVideo_Click"
                                        Style="{StaticResource PrimaryButtonStyle}" Padding="10,7" Margin="0,0,0,12" />

                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="Bitrate" FontSize="12" Foreground="#9CA3AF" />
                                    <TextBlock x:Name="TxtBitrateValue" Text="6 Mbps" FontSize="12" FontWeight="SemiBold" Foreground="#F3F4F6" HorizontalAlignment="Right" />
                                </DockPanel>
                                <Slider x:Name="SldBitrate" Minimum="2" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="6" ValueChanged="SldBitrate_ValueChanged" Margin="0,2,0,10" />

                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="Zoom" FontSize="12" Foreground="#9CA3AF" />
                                    <TextBlock x:Name="TxtZoomValue" Text="1.0x" FontSize="12" FontWeight="SemiBold" Foreground="#F3F4F6" HorizontalAlignment="Right" />
                                </DockPanel>
                                <Grid Margin="0,2,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="SldZoom" Grid.Column="0" Minimum="1.0" Maximum="5.0" TickFrequency="0.1"
                                            SmallChange="0.1" LargeChange="0.5" Value="1.0" ValueChanged="SldZoom_ValueChanged"
                                            VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="1x" Click="BtnResetZoom_Click" Padding="9,3" Margin="8,0,0,0" FontSize="11" />
                                </Grid>

                                <CheckBox x:Name="ChkMirrorH" Content="Mirror Horizontal (Selfie)" Checked="TransformOption_Changed"
                                          Unchecked="TransformOption_Changed" Margin="0,4,0,6" />
                                <CheckBox x:Name="ChkFlipV" Content="Flip Vertical" Checked="TransformOption_Changed"
                                          Unchecked="TransformOption_Changed" />
                            </StackPanel>
                        </Border>

                        <!-- Microphone Card -->
                        <Border Background="#11161F" BorderBrush="#222938" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="MICROPHONE" FontSize="10.5" FontWeight="Bold" Foreground="#34D399" Margin="0,0,0,8" />
                                <TextBlock x:Name="TxtVirtualMicStatus" Text="Checking audio devices..." FontSize="11"
                                           Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,0,0,8" />

                                <CheckBox x:Name="ChkMicEnabled" Content="Enable Phone Microphone"
                                          Checked="ChkMicEnabled_Changed" Unchecked="ChkMicEnabled_Changed" Margin="0,0,0,6" />
                                <CheckBox x:Name="ChkMicMuted" Content="Mute Microphone"
                                          Checked="ChkMicMuted_Changed" Unchecked="ChkMicMuted_Changed" Margin="0,0,0,10" />

                                <TextBlock Text="Audio Output / Virtual Cable" FontSize="11.5" Foreground="#9CA3AF" />
                                <ComboBox x:Name="CmbAudioDevice" SelectionChanged="CmbAudioDevice_SelectionChanged" Margin="0,4,0,8" />

                                <Button x:Name="BtnInstallVbCable" Content="Get VB-CABLE Virtual Mic Driver"
                                        Click="BtnInstallVbCable_Click" Padding="10,6" Margin="0,0,0,10"
                                        Background="#1E293B" BorderBrush="#334155" Foreground="#93C5FD" FontSize="11.5" />

                                <DockPanel Margin="0,0,0,2">
                                    <TextBlock Text="Mic Gain" FontSize="12" Foreground="#9CA3AF" />
                                    <TextBlock x:Name="TxtMicGainValue" Text="100%" FontSize="12" FontWeight="SemiBold" Foreground="#F3F4F6" HorizontalAlignment="Right" />
                                </DockPanel>
                                <Slider x:Name="SldMicGain" Minimum="0" Maximum="250" TickFrequency="10" IsSnapToTickEnabled="True"
                                        Value="100" ValueChanged="SldMicGain_ValueChanged" Margin="0,2,0,8" />
                                <ProgressBar x:Name="PrgMicLevel" Minimum="0" Maximum="100" Height="7"
                                             Background="#0B0E14" Foreground="#34D399" />
                            </StackPanel>
                        </Border>

                        <!-- Startup & Window Card -->
                        <Border Background="#11161F" BorderBrush="#222938" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="STARTUP &amp; TRAY" FontSize="10.5" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,8" />
                                <CheckBox x:Name="ChkStartWithWindows" Content="Start minimized at Windows login"
                                          Checked="ChkStartWithWindows_Changed" Unchecked="ChkStartWithWindows_Changed" Margin="0,0,0,6" />
                                <CheckBox x:Name="ChkMinimizeToTray" Content="Minimize to tray on close"
                                          Checked="ChkMinimizeToTray_Changed" Unchecked="ChkMinimizeToTray_Changed" Margin="0,0,0,10" />
                                <Button Content="Hide to Tray" Click="BtnHideToTray_Click" Padding="10,6" />
                            </StackPanel>
                        </Border>

                        <!-- Collapsible Advanced & Diagnostics -->
                        <Expander IsExpanded="False">
                            <Expander.Header>
                                <TextBlock Text="ADVANCED &amp; DIAGNOSTICS" FontSize="10.5" FontWeight="Bold" Foreground="#9CA3AF" />
                            </Expander.Header>
                            <StackPanel>
                                <Border Background="#0B0E14" BorderBrush="#1E2532" BorderThickness="1" CornerRadius="8" Padding="9" Margin="0,0,0,10">
                                    <TextBlock x:Name="TxtStats" Text="Waiting for stream..." FontFamily="Consolas" FontSize="11"
                                               Foreground="#D1D5DB" TextWrapping="Wrap" />
                                </Border>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnVirtualCam" Grid.Column="0" Content="VCam: Auto" Click="BtnVirtualCam_Click" FontSize="11.5" Padding="8,6" />
                                    <Button x:Name="BtnAdbReverse" Grid.Column="2" Content="USB Re-bind" Click="BtnAdbReverse_Click" FontSize="11.5" Padding="8,6" />
                                </Grid>
                                <Button x:Name="BtnKeyframe" Content="Request Keyframe" Click="BtnKeyframe_Click" FontSize="11.5" Padding="8,6" Margin="0,0,0,10" />
                                <CheckBox x:Name="ChkDebugLog" Content="Show Debug Log" Checked="ChkDebugLog_Changed" Unchecked="ChkDebugLog_Changed" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Collapsible Debug Log -->
        <Border x:Name="LogPanel" Grid.Row="2" Background="#161B24" BorderBrush="#262F3F" BorderThickness="1"
                CornerRadius="12" Padding="12" Margin="0,12,0,0" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="115" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="DEBUG LOG" FontSize="11" FontWeight="Bold" Foreground="#9CA3AF" VerticalAlignment="Center" />
                    <Button Content="Clear" Click="BtnClearLog_Click" HorizontalAlignment="Right" Padding="10,3" FontSize="11" />
                </DockPanel>
                <Border Grid.Row="1" Background="#0B0E14" BorderBrush="#1E2532" BorderThickness="1" CornerRadius="8" Padding="4">
                    <TextBox x:Name="TxtLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" Background="Transparent" Foreground="#A7F3D0"
                             FontFamily="Consolas" FontSize="11" BorderThickness="0" Padding="4" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
