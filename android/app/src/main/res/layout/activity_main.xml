<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111318"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PhoneCam"
        android:textColor="#F3F4F6"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="USB + WiFi H.264 Streamer (Phase 2)"
        android:textColor="#9CA3AF"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="#1B1F27"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Idle"
            android:textColor="#60A5FA"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:text="1280x720 @ 30 fps | 0.00 Mbps\nSent: 0 | Dropped: 0"
            android:textColor="#D1D5DB"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#F87171"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnModeUsb"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="#2563EB"
            android:text="USB (adb)"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnModeWifi"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="#374151"
            android:text="WiFi / Hotspot"
            android:textAllCaps="false"
            android:textColor="#F3F4F6" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvHostLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Target Host (127.0.0.1 for USB adb reverse)"
        android:textColor="#9CA3AF"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etHost"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#1B1F27"
            android:hint="127.0.0.1"
            android:inputType="textUri"
            android:padding="12dp"
            android:text="127.0.0.1"
            android:textColor="#F3F4F6"
            android:textColorHint="#6B7280" />

        <Button
            android:id="@+id/btnDiscover"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#374151"
            android:text="Scan PC"
            android:textAllCaps="false"
            android:textColor="#F3F4F6"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDiscoveryHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#9CA3AF"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Port"
        android:textColor="#9CA3AF"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/etPort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="#1B1F27"
        android:hint="18420"
        android:inputType="number"
        android:padding="12dp"
        android:text="18420"
        android:textColor="#F3F4F6"
        android:textColorHint="#6B7280" />

    <Button
        android:id="@+id/btnSwitchCam"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="18dp"
        android:backgroundTint="#374151"
        android:text="Camera: Back"
        android:textAllCaps="false"
        android:textColor="#F3F4F6"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnToggle"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="#2563EB"
        android:text="Start Streaming"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Auto-reconnect is active: temporary WiFi/USB drops will automatically reconnect until you tap Stop."
        android:textColor="#6B7280"
        android:textSize="12sp" />

</LinearLayout>
